#!/bin/sh
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
{{- if not .work }}
# Brewfile.personal hash: {{ include "Brewfile.personal" | sha256sum }}
{{- end }}
# Runs before chezmoi writes any file, so the Brewfiles are read from the source
# directory. The hashes above make chezmoi rerun this when either changes.
set -eu

if ! command -v brew >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/brew ]; then
  echo "Installing Homebrew. It will ask for your password for sudo."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle --file "{{ .chezmoi.sourceDir }}/Brewfile"
{{- if not .work }}
brew bundle --file "{{ .chezmoi.sourceDir }}/Brewfile.personal"
{{- end }}
