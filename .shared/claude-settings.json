{
  "agentPushNotifEnabled": false,
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/spec-review-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/brainstorm-worktree.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/brainstorm-worktree.sh"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 2,
    "type": "command"
  },
  "theme": "dark",
  "permissions": {
    "allow": [
      "Read(~/TODO.md)",
      "Edit(~/TODO.md)",
      "Write(~/TODO.md)"
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  }
}
